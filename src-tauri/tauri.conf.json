{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapDiff",
  "version": "0.2.5",
  "identifier": "com.snapdiff.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SnapDiff - 目录快照管理",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "dragDropEnabled": true,
        "visible": false,
        "backgroundColor": "#0d1219"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
